{
  "manifest_version": 3,
  "name": "MedX Prescription Validator",
  "version": "2.0.0",
  "description": "Prescription OCR and validation",
  "permissions": ["sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Open MedX"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}