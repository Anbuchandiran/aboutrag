{
  "manifest_version": 3,
  "name": "MedX Prescription Validator",
  "version": "2.0.0",
  "description": "Prescription OCR and validation",
  "permissions": ["sidePanel"],
  "host_permissions": [
  "https://pursuant-pearl-semiopenly.ngrok-free.dev/*"
  ],
  "action": {
    "default_title": "Open MedX"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
